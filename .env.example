# Database
DATABASE_URL=postgresql://username:password@ep-endpoint-id.region.aws.neon.tech/database-name?sslmode=require

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_complex
JWT_EXPIRES_IN=24h

# Server
NODE_ENV=development
PORT=3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001